# Optional: set a stable 32-byte hex secret to encrypt saved model API keys.
# Generate a value with: openssl rand -hex 32
MODEL_CONFIG_SECRET=

# Optional API port (defaults to 3001)
PORT=3001

# Backend: comma-separated exact browser origins allowed to call /api.
# Defaults to localhost:5173 and 127.0.0.1:5173 in development; set this explicitly in production.
# Example: FRONTEND_ORIGINS=https://studio.example.com
FRONTEND_ORIGINS=

# Frontend build-time URL for the separately deployed backend.
# Set this in the frontend hosting/build environment (not as a server secret).
# Example: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Optional Vite development proxy target when the local backend is hosted elsewhere.
# Example: VITE_DEV_API_PROXY_TARGET=http://localhost:3001
VITE_DEV_API_PROXY_TARGET=

# Protect backend-only real-time usage monitoring endpoints. Generate with: openssl rand -hex 32
# Never expose this token in frontend code or Vite environment variables.
OBSERVABILITY_TOKEN=

# Exact account emails allowed to access the read-only web admin dashboard.
# Multiple administrators can be separated by commas.
ADMIN_EMAILS=
